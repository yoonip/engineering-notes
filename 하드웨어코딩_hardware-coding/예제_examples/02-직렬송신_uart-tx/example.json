  "id": "02-uart-tx",
  "title": "8N1 직렬 송신과 비트 유지 시간",
  "language": "SystemVerilog",
  "contract": {
    "clock_period_ns": 10,
    "clocks_per_bit_valid_range": [
      2,
      16
    ],
    "data_bits": 8,
    "parity": "none",
    "stop_bits": 1,
    "bit_order": "LSB first",
    "idle_level": 1,
    "start_level": 0,
    "request": "posedge clk, rst=0, ready=1 and send=1",
    "busy_request": "ignored",
    "reset": "active-high synchronous; abort frame without done",
    "done": "one clock after exactly 10*CLOCKS_PER_BIT intervals since acceptance"
  },
  "independent_oracle": "DUT 내부 frame·ticks·bit_index를 읽지 않고 원래 요청 바이트와 경과 클록의 외부 시간표만 비교합니다.",
