      "relative_clock": "3..5",
      "serial": "0",
      "meaning": "A6 bit0"
    },
    {
      "relative_clock": "6..8",
      "serial": "1",
      "meaning": "A6 bit1"
    },
    {
      "relative_clock": "9..26",
