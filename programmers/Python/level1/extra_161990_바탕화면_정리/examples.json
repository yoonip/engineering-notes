{
  "source": "https://school.programmers.co.kr/learn/courses/30/lessons/161990",
  "cases": [
    {
      "arguments": [
        [
          ".#...",
          "..#..",
          "...#."
        ]
      ],
      "expected": [
        0,
        1,
        3,
        4
      ]
    },
    {
      "arguments": [
        [
          "..........",
          ".....#....",
          "......##..",
          "...##.....",
          "....#....."
        ]
      ],
      "expected": [
        1,
        3,
        5,
        8
      ]
    },
    {
      "arguments": [
        [
          ".##...##.",
          "#..#.#..#",
          "#...#...#",
          ".#.....#.",
          "..#...#..",
          "...#.#...",
          "....#...."
        ]
      ],
      "expected": [
        0,
        0,
        7,
        9
      ]
    },
    {
      "arguments": [
        [
          "..",
          "#."
        ]
      ],
      "expected": [
        1,
        0,
        2,
        1
      ]
    }
  ]
}
