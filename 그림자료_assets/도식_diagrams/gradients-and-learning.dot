digraph Diagram {
graph [rankdir=TB,bgcolor="white",pad="0.2",nodesep="0.45",ranksep="0.48",splines=polyline,outputorder=edgesfirst];
node [fontname="Malgun Gothic",fontsize=14,shape=box,style=filled,color="#596570",fillcolor="#ffffff",fontcolor="#252c33",penwidth=0.9,margin="0.12,0.08"];
edge [fontname="Malgun Gothic",fontsize=12,color="#596570",fontcolor="#374a59",penwidth=1.0,arrowsize=0.65];
"X"[label="입력 x\nInput",shape="box",width=0.917,height=0.750,fixedsize=true];
"Z"[label="wx+b",shape="box",width=0.861,height=0.486,fixedsize=true];
"S"[label="sigmoid",shape="box",width=1.028,height=0.486,fixedsize=true];
"L"[label="손실\nLoss",shape="box",width=0.736,height=0.750,fixedsize=true];
"Y"[label="정답 y\nLabel",shape="box",width=0.931,height=0.750,fixedsize=true];
"W"[label="갱신\nUpdate w,b",shape="box",width=1.347,height=0.750,fixedsize=true];
"X"->"Z"[label=""];
"Z"->"S"[label=""];
"S"->"L"[label=""];
"Y"->"L"[label=""];
"L"->"Z"[label="기울기\nGradient",style=dashed];
"Z"->"W"[label="",style=dashed];
}
