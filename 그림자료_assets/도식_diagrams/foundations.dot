"D"[label="메모리·펌웨어·시스템\nMemory, firmware and\nsystems",shape="box",width=2.319,height=1.014,fixedsize=true];
"E"[label="센서·ADC·신호\nSensors, ADCs and signals",shape="box",width=2.639,height=0.750,fixedsize=true];
"F"[label="제어·학습·병렬 계산\nControl, learning and\nparallel computing",shape="box",width=2.181,height=1.014,fixedsize=true];
