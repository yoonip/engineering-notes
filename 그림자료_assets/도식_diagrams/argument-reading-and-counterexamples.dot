digraph Diagram {
graph [rankdir=TB,bgcolor="white",pad="0.2",nodesep="0.45",ranksep="0.48",splines=polyline,outputorder=edgesfirst];
node [fontname="Malgun Gothic",fontsize=14,shape=box,style=filled,color="#596570",fillcolor="#ffffff",fontcolor="#252c33",penwidth=0.9,margin="0.12,0.08"];
edge [fontname="Malgun Gothic",fontsize=12,color="#596570",fontcolor="#374a59",penwidth=1.0,arrowsize=0.65];
"P"[label="근거\nEvidence",shape="box",width=1.125,height=0.750,fixedsize=true];
"I"[label="연결 가정\nInferential link",shape="box",width=1.583,height=0.750,fixedsize=true];
"C"[label="결론\nConclusion",shape="box",width=1.306,height=0.750,fixedsize=true];
"A"[label="대안 설명\nAlternative",shape="box",width=1.306,height=0.750,fixedsize=true];
"E"[label="반대 자료\nContrary evidence",shape="box",width=1.944,height=0.750,fixedsize=true];
"S"[label="적용 범위\nScope",shape="box",width=1.194,height=0.750,fixedsize=true];
"P"->"I"[label=""];
"I"->"C"[label=""];
"A"->"I"[label="",style=dashed];
"E"->"P"[label="",style=dashed];
"S"->"C"[label="",style=dashed];
}
