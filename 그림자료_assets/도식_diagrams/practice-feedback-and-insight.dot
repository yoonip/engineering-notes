digraph Diagram {
graph [rankdir=TB,bgcolor="white",pad="0.2",nodesep="0.45",ranksep="0.48",splines=polyline,outputorder=edgesfirst];
node [fontname="Malgun Gothic",fontsize=14,shape=box,style=filled,color="#596570",fillcolor="#ffffff",fontcolor="#252c33",penwidth=0.9,margin="0.12,0.08"];
edge [fontname="Malgun Gothic",fontsize=12,color="#596570",fontcolor="#374a59",penwidth=1.0,arrowsize=0.65];
"A"[label="원문과 조건\nSource and conditions",shape="box",width=2.306,height=0.750,fixedsize=true];
"B"[label="독립 풀이\nIndependent attempt",shape="box",width=2.208,height=0.750,fixedsize=true];
"C"[label="공식 답과 검산\nOfficial answer and check",shape="box",width=2.583,height=0.750,fixedsize=true];
"D"[label="오류 원인 수정\nCorrect the cause",shape="box",width=1.917,height=0.750,fixedsize=true];
"E"[label="시간 뒤 인출\nDelayed retrieval",shape="box",width=1.792,height=0.750,fixedsize=true];
"F"[label="새 자료에서 확인\nCheck on unseen material",shape="box",width=2.611,height=0.750,fixedsize=true];
"A"->"B"[label=""];
"B"->"C"[label=""];
"C"->"D"[label=""];
"D"->"E"[label=""];
"E"->"F"[label=""];
}
