"CPU"[label="CPU",shape="box",width=0.736,height=0.486,fixedsize=true];
"DEVICE_TX"[label="DEVICE_TX",shape="box",width=1.306,height=0.486,fixedsize=true];
"DEVICE_RX"[label="DEVICE_RX",shape="box",width=1.333,height=0.486,fixedsize=true];
"DONE_RX"[label="DONE_RX",shape="box",width=1.236,height=0.486,fixedsize=true];
