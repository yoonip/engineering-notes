digraph Diagram {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.65", ranksep="0.65", splines=spline, outputorder=edgesfirst];
node [fontname="Malgun Gothic", fontsize=15, shape=box, style="rounded,filled", color="#2563a3", fillcolor="#edf5ff", fontcolor="#172b45", penwidth=1.4, margin="0.20,0.13"];
edge [fontname="Malgun Gothic", fontsize=12, color="#52677f", fontcolor="#243e5c", penwidth=1.35, arrowsize=0.75];
"A" [label="Gate 전압\nVoltage", shape="box", width=1.505, height=0.861, fixedsize=true];
"B" [label="표면 전하\nSurface charge", shape="box", width=1.985, height=0.861, fixedsize=true];
"C" [label="채널 전류\nChannel current", shape="box", width=2.135, height=0.861, fixedsize=true];
"D" [label="부하 충전\nLoad charging", shape="box", width=1.940, height=0.861, fixedsize=true];
"E" [label="지연·에너지\nDelay and energy", shape="box", width=2.285, height=0.861, fixedsize=true];
"A" -> "B" [label=""];
"B" -> "C" [label=""];
"C" -> "D" [label=""];
"D" -> "E" [label=""];
}
