digraph Diagram {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.65", ranksep="0.65", splines=spline, outputorder=edgesfirst];
node [fontname="Malgun Gothic", fontsize=15, shape=box, style="rounded,filled", color="#2563a3", fillcolor="#edf5ff", fontcolor="#172b45", penwidth=1.4, margin="0.20,0.13"];
edge [fontname="Malgun Gothic", fontsize=12, color="#52677f", fontcolor="#243e5c", penwidth=1.35, arrowsize=0.75];
"A" [label="외부 바이트\nUntrusted bytes", shape="box", width=2.090, height=0.861, fixedsize=true];
"B" [label="길이·형식 제한\nBound and parse", shape="box", width=2.240, height=0.861, fixedsize=true];
"C" [label="무결성·인증\nIntegrity and\nauthentication", shape="box", width=1.955, height=1.153, fixedsize=true];
"D" [label="재전송·권한·범위 검사\nFreshness and\nauthorization", shape="box", width=2.660, height=1.153, fixedsize=true];
"E" [label="허용된 동작\nPermitted action", shape="box", width=2.150, height=0.861, fixedsize=true];
"A" -> "B" [label=""];
"B" -> "C" [label=""];
"C" -> "D" [label=""];
"D" -> "E" [label=""];
}
