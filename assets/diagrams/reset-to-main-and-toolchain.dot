digraph Diagram {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.65", ranksep="0.65", splines=spline, outputorder=edgesfirst];
node [fontname="Malgun Gothic", fontsize=15, shape=box, style="rounded,filled", color="#2563a3", fillcolor="#edf5ff", fontcolor="#172b45", penwidth=1.4, margin="0.20,0.13"];
edge [fontname="Malgun Gothic", fontsize=12, color="#52677f", fontcolor="#243e5c", penwidth=1.35, arrowsize=0.75];
"A" [label="소스\nSource", shape="box", width=1.160, height=0.861, fixedsize=true];
"B" [label="컴파일·어셈블\nCompile and assemble", shape="box", width=2.795, height=0.861, fixedsize=true];
"C" [label="목적 파일\nObject files", shape="box", width=1.640, height=0.861, fixedsize=true];
"D" [label="링크·배치\nLink and place", shape="box", width=1.970, height=0.861, fixedsize=true];
"E" [label="ELF", shape="box", width=0.800, height=0.569, fixedsize=true];
"F" [label="로더 또는 플래시 기록\nLoader or flash\nprogramming", shape="box", width=2.720, height=1.153, fixedsize=true];
"G" [label="시작 코드\nStartup", shape="box", width=1.445, height=0.861, fixedsize=true];
"H" [label="main 또는 앱 진입점\nApplication entry", shape="box", width=2.540, height=0.861, fixedsize=true];
"A" -> "B" [label=""];
"B" -> "C" [label=""];
"C" -> "D" [label=""];
"D" -> "E" [label=""];
"E" -> "F" [label=""];
"F" -> "G" [label=""];
"G" -> "H" [label=""];
}
