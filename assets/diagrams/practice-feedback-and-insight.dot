digraph Diagram {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.65", ranksep="0.65", splines=spline, outputorder=edgesfirst];
node [fontname="Malgun Gothic", fontsize=15, shape=box, style="rounded,filled", color="#2563a3", fillcolor="#edf5ff", fontcolor="#172b45", penwidth=1.4, margin="0.20,0.13"];
edge [fontname="Malgun Gothic", fontsize=12, color="#52677f", fontcolor="#243e5c", penwidth=1.35, arrowsize=0.75];
"A" [label="원문과 조건\nSource and conditions", shape="box", width=2.780, height=0.861, fixedsize=true];
"B" [label="독립 풀이\nIndependent attempt", shape="box", width=2.660, height=0.861, fixedsize=true];
"C" [label="공식 답과 검산\nOfficial answer and check", shape="box", width=3.125, height=0.861, fixedsize=true];
"D" [label="오류 원인 수정\nCorrect the cause", shape="box", width=2.255, height=0.861, fixedsize=true];
"E" [label="시간 뒤 인출\nDelayed retrieval", shape="box", width=2.165, height=0.861, fixedsize=true];
"F" [label="새 자료에서 확인\nCheck on unseen material", shape="box", width=3.140, height=0.861, fixedsize=true];
"A" -> "B" [label=""];
"B" -> "C" [label=""];
"C" -> "D" [label=""];
"D" -> "E" [label=""];
"E" -> "F" [label=""];
}
