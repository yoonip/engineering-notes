digraph Diagram {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.65", ranksep="0.65", splines=spline, outputorder=edgesfirst];
node [fontname="Malgun Gothic", fontsize=15, shape=box, style="rounded,filled", color="#2563a3", fillcolor="#edf5ff", fontcolor="#172b45", penwidth=1.4, margin="0.20,0.13"];
edge [fontname="Malgun Gothic", fontsize=12, color="#52677f", fontcolor="#243e5c", penwidth=1.35, arrowsize=0.75];
"A" [label="질문과 용어\nQuestion and terms", shape="box", width=2.525, height=0.861, fixedsize=true];
"B" [label="사실·근거\nFacts and evidence", shape="box", width=2.405, height=0.861, fixedsize=true];
"D" [label="전제·추론·반론\nPremises and objections", shape="box", width=2.960, height=0.861, fixedsize=true];
"C" [label="가치·우선순위\nValues and priorities", shape="box", width=2.585, height=0.861, fixedsize=true];
"E" [label="범위를 밝힌 결론\nQualified conclusion", shape="box", width=2.600, height=0.861, fixedsize=true];
"F" [label="새 근거에 따른 수정\nRevision with new evidence", shape="box", width=3.290, height=0.861, fixedsize=true];
"A" -> "B" [label=""];
"B" -> "D" [label=""];
"C" -> "D" [label=""];
"D" -> "E" [label=""];
"E" -> "F" [label=""];
}
