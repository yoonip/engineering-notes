digraph Diagram {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.65", ranksep="0.65", splines=spline, outputorder=edgesfirst];
node [fontname="Malgun Gothic", fontsize=15, shape=box, style="rounded,filled", color="#2563a3", fillcolor="#edf5ff", fontcolor="#172b45", penwidth=1.4, margin="0.20,0.13"];
edge [fontname="Malgun Gothic", fontsize=12, color="#52677f", fontcolor="#243e5c", penwidth=1.35, arrowsize=0.75];
"__START" [label="",shape=point,width=0.08,height=0.08];
"WAIT" [label="WAIT", shape="box", width=1.025, height=0.569, fixedsize=true];
"COLLECT" [label="COLLECT", shape="box", width=1.370, height=0.569, fixedsize=true];
"ESCAPE" [label="ESCAPE", shape="box", width=1.265, height=0.569, fixedsize=true];
"DROP" [label="DROP", shape="box", width=1.085, height=0.569, fixedsize=true];
"__START" -> "WAIT" [label="1"];
"WAIT" -> "COLLECT" [label="2"];
"COLLECT" -> "ESCAPE" [label="3"];
"ESCAPE" -> "COLLECT" [label="4"];
"COLLECT" -> "COLLECT" [label="5"];
