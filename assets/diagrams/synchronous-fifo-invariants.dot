digraph Diagram {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.65", ranksep="0.65", splines=spline, outputorder=edgesfirst];
node [fontname="Malgun Gothic", fontsize=15, shape=box, style="rounded,filled", color="#2563a3", fillcolor="#edf5ff", fontcolor="#172b45", penwidth=1.4, margin="0.20,0.13"];
edge [fontname="Malgun Gothic", fontsize=12, color="#52677f", fontcolor="#243e5c", penwidth=1.35, arrowsize=0.75];
"P" [label="생산자\nProducer", shape="box", width=1.400, height=0.861, fixedsize=true];
"G" [label="수락 판단\nAcceptance", shape="box", width=1.655, height=0.861, fixedsize=true];
"M" [label="순환 저장 배열\nRing memory", shape="box", width=1.955, height=0.861, fixedsize=true];
"R" [label="읽기 레지스터\nRead register", shape="box", width=1.865, height=0.861, fixedsize=true];
"C" [label="소비자\nConsumer", shape="box", width=1.520, height=0.861, fixedsize=true];
"N" [label="점유량 n\nOccupancy", shape="box", width=1.610, height=0.861, fixedsize=true];
"P" -> "G" [label="write + data"];
"G" -> "M" [label=""];
"M" -> "R" [label=""];
"R" -> "C" [label=""];
"N" -> "G" [label=""];
"G" -> "N" [label=""];
}
