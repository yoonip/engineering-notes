digraph Diagram {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.65", ranksep="0.65", splines=spline, outputorder=edgesfirst];
node [fontname="Malgun Gothic", fontsize=15, shape=box, style="rounded,filled", color="#2563a3", fillcolor="#edf5ff", fontcolor="#172b45", penwidth=1.4, margin="0.20,0.13"];
edge [fontname="Malgun Gothic", fontsize=12, color="#52677f", fontcolor="#243e5c", penwidth=1.35, arrowsize=0.75];
"S" [label="문제의 사고 조건\nGiven incident conditions", shape="box", width=3.110, height=0.861, fixedsize=true];
"C" [label="국가 보상 대상?\nCompensation eligible?", shape="diamond", width=5.193, height=1.550, fixedsize=true,style=filled];
"P" [label="피해자에게 지급\nPay injured party", shape="box", width=2.225, height=0.861, fixedsize=true];
"R" [label="사후 청구 조건?\nRecourse condition?", shape="diamond", width=4.599, height=1.550, fixedsize=true,style=filled];
"D" [label="의료인에게 청구 가능\nRecourse permitted", shape="box", width=2.645, height=0.861, fixedsize=true];
"S" -> "C" [label=""];
"C" -> "P" [label="해당\nYes"];
"P" -> "R" [label=""];
"R" -> "D" [label="해당\nYes"];
}
