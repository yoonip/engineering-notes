digraph Diagram {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.65", ranksep="0.65", splines=spline, outputorder=edgesfirst];
node [fontname="Malgun Gothic", fontsize=15, shape=box, style="rounded,filled", color="#2563a3", fillcolor="#edf5ff", fontcolor="#172b45", penwidth=1.4, margin="0.20,0.13"];
edge [fontname="Malgun Gothic", fontsize=12, color="#52677f", fontcolor="#243e5c", penwidth=1.35, arrowsize=0.75];
"A" [label="요청\nRequest", shape="box", width=1.295, height=0.861, fixedsize=true];
"B" [label="L1 hit?", shape="diamond", width=2.061, height=1.025, fixedsize=true,style=filled];
"C" [label="데이터 반환\nReturn", shape="box", width=1.670, height=0.861, fixedsize=true];
"D" [label="하위 계층 접근\nLower level", shape="box", width=1.970, height=0.861, fixedsize=true];
"E" [label="Line 채움\nFill", shape="box", width=1.415, height=0.861, fixedsize=true];
"A" -> "B" [label=""];
"B" -> "C" [label="yes"];
"B" -> "D" [label="no"];
"D" -> "E" [label=""];
"E" -> "C" [label=""];
}
