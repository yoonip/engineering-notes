digraph Diagram {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.65", ranksep="0.65", splines=spline, outputorder=edgesfirst];
node [fontname="Malgun Gothic", fontsize=15, shape=box, style="rounded,filled", color="#2563a3", fillcolor="#edf5ff", fontcolor="#172b45", penwidth=1.4, margin="0.20,0.13"];
edge [fontname="Malgun Gothic", fontsize=12, color="#52677f", fontcolor="#243e5c", penwidth=1.35, arrowsize=0.75];
"VA" [label="가상 주소\nVirtual address", shape="box", width=2.045, height=0.861, fixedsize=true];
"SPLIT" [label="페이지 번호 + 오프셋\nVPN + offset", shape="box", width=2.690, height=0.861, fixedsize=true];
"LOOKUP" [label="TLB 또는 페이지 테이블\nTranslation lookup", shape="box", width=2.870, height=0.861, fixedsize=true];
"CHECK" [label="매핑·권한 유효?\nValid mapping and\npermission?", shape="diamond", width=4.410, height=2.075, fixedsize=true,style=filled];
"PA" [label="물리 프레임 + 오프셋\nPFN + offset", shape="box", width=2.660, height=0.861, fixedsize=true];
"FAULT" [label="예외·커널 처리\nFault handling", shape="box", width=1.955, height=0.861, fixedsize=true];
"VA" -> "SPLIT" [label=""];
"SPLIT" -> "LOOKUP" [label=""];
"LOOKUP" -> "CHECK" [label=""];
"CHECK" -> "PA" [label="Yes"];
"CHECK" -> "FAULT" [label="No"];
}
