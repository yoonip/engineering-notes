digraph Diagram {
graph [rankdir=LR,bgcolor="white",pad="0.2",nodesep="0.45",ranksep="0.48",splines=polyline,outputorder=edgesfirst];
node [fontname="Malgun Gothic",fontsize=14,shape=box,style=filled,color="#596570",fillcolor="#ffffff",fontcolor="#252c33",penwidth=0.9,margin="0.12,0.08"];
edge [fontname="Malgun Gothic",fontsize=12,color="#596570",fontcolor="#374a59",penwidth=1.0,arrowsize=0.65];
"A"[label="연속 신호\nContinuous signal",shape="box",width=1.903,height=0.750,fixedsize=true];
"B"[label="아날로그 대역 제한\nAnalog band limiting",shape="box",width=2.167,height=0.750,fixedsize=true];
"C"[label="시간 표본\nTime samples",shape="box",width=1.528,height=0.750,fixedsize=true];
"D"[label="양자화\nQuantization",shape="box",width=1.472,height=0.750,fixedsize=true];
"E"[label="디지털 처리\nDigital processing",shape="box",width=1.889,height=0.750,fixedsize=true];
"A"->"B"[label=""];
"B"->"C"[label=""];
"C"->"D"[label=""];
"D"->"E"[label=""];
}
