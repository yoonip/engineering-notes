digraph Diagram {
graph [rankdir=TB,bgcolor="white",pad="0.2",nodesep="0.45",ranksep="0.48",splines=polyline,outputorder=edgesfirst];
node [fontname="Malgun Gothic",fontsize=14,shape=box,style=filled,color="#596570",fillcolor="#ffffff",fontcolor="#252c33",penwidth=0.9,margin="0.12,0.08"];
edge [fontname="Malgun Gothic",fontsize=12,color="#596570",fontcolor="#374a59",penwidth=1.0,arrowsize=0.65];
"VA"[label="가상 주소\nVirtual address",shape="box",width=1.667,height=0.750,fixedsize=true];
"SPLIT"[label="페이지 번호 + 오프셋\nVPN + offset",shape="box",width=2.264,height=0.750,fixedsize=true];
"LOOKUP"[label="TLB 또는 페이지 테이블\nTranslation lookup",shape="box",width=2.444,height=0.750,fixedsize=true];
"CHECK"[label="매핑·권한 유효?\nValid mapping and\npermission?",shape="diamond",width=3.200,height=1.622,fixedsize=true];
"PA"[label="물리 프레임 + 오프셋\nPFN + offset",shape="box",width=2.264,height=0.750,fixedsize=true];
"FAULT"[label="예외·커널 처리\nFault handling",shape="box",width=1.625,height=0.750,fixedsize=true];
"VA"->"SPLIT"[label=""];
"SPLIT"->"LOOKUP"[label=""];
"LOOKUP"->"CHECK"[label=""];
"CHECK"->"PA"[label="Yes"];
"CHECK"->"FAULT"[label="No"];
}
