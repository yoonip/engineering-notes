digraph Diagram {
graph [rankdir=TB,bgcolor="white",pad="0.2",nodesep="0.45",ranksep="0.48",splines=polyline,outputorder=edgesfirst];
node [fontname="Malgun Gothic",fontsize=14,shape=box,style=filled,color="#596570",fillcolor="#ffffff",fontcolor="#252c33",penwidth=0.9,margin="0.12,0.08"];
edge [fontname="Malgun Gothic",fontsize=12,color="#596570",fontcolor="#374a59",penwidth=1.0,arrowsize=0.65];
"A"[label="요청\nRequest",shape="box",width=1.056,height=0.750,fixedsize=true];
"B"[label="L1 hit?",shape="diamond",width=1.511,height=0.778,fixedsize=true];
"C"[label="데이터 반환\nReturn",shape="box",width=1.389,height=0.750,fixedsize=true];
"D"[label="하위 계층 접근\nLower level",shape="box",width=1.667,height=0.750,fixedsize=true];
"E"[label="Line 채움\nFill",shape="box",width=1.167,height=0.750,fixedsize=true];
"A"->"B"[label=""];
"B"->"C"[label="yes"];
"B"->"D"[label="no"];
"D"->"E"[label=""];
"E"->"C"[label=""];
}
