{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "현재 파일 디버깅 준비 (input.txt)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\run.ps1",
        "-Source",
        "${file}",
        "-BuildOnly",
        "-PrepareDebugInput"
      ],
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "현재 파일 디버깅 준비 (키보드)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\run.ps1",
        "-Source",
        "${file}",
        "-BuildOnly",
        "-KeyboardInput"
      ],
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "현재 파일 실행 (input.txt 자동 입력)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\run.ps1",
        "-Source",
        "${file}"
      ],
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "현재 파일 실행 (키보드 입력)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\run.ps1",
        "-Source",
        "${file}",
        "-KeyboardInput"
      ],
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
